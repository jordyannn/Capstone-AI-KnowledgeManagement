# Salin ke .env lalu ganti nilainya. Jangan commit .env.

HTTP_PORT=8080

POSTGRES_USER=kms
POSTGRES_PASSWORD=ganti-dengan-sandi-database
POSTGRES_DB=kms

# Minimal 32 karakter. Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ganti-dengan-string-acak-minimal-32-karakter

# Sesi berakhir setelah tidak aktif selama N menit.
ACCESS_TOKEN_MINUTES=30
# true bila diakses lewat HTTPS.
COOKIE_SECURE=false

# Admin awal, dibuat sekali saat container backend start jika belum ada.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ganti-dengan-sandi-admin
SEED_ADMIN_NAME=Administrator

# --- Pipeline data (SCRUM-36 / SCRUM-38) ---
# Model embedding. Mengganti model berarti semua dokumen harus di-index ulang:
#   docker compose exec backend python -m app.ingest.requeue --all
# Model keluarga "e5" otomatis memakai awalan "passage: " / "query: ".
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_BATCH_SIZE=32
CHROMA_COLLECTION=kms_chunks
WORKER_POLL_SECONDS=5

# --- Login SSO Microsoft / akun Telkom University (SCRUM-73) ---
# Mati bawaannya. Cara mengaktifkan: lihat README, bagian "Login SSO Microsoft".
# Client secret hanya boleh ada di .env (yang di-gitignore), jangan pernah di kode atau commit.
SSO_ENABLED=false
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Bawaan di bawah sudah benar untuk Tel-U dan development lokal; ubah hanya bila perlu.
SSO_TENANT_ID=90affe0f-c2a3-4108-bb98-6ceb4e94ef15
SSO_REDIRECT_URI=http://localhost:8080/api/auth/sso/callback
SSO_ALLOWED_DOMAINS=telkomuniversity.ac.id,student.telkomuniversity.ac.id

# --- Pilihan model komersial (seperti proyek KP) ---
# Mati bawaannya: semua jawaban dari Ollama lokal. Bila diaktifkan, pengguna bisa memilih model di
# halaman chat, TETAPI pertanyaan yang memuat data pribadi (NIM, telepon, surel) atau kata sensitif
# (SENSITIVE_KEYWORDS) tetap dijawab model lokal. API key hanya di .env, jangan pernah di-commit.
COMMERCIAL_LLM_ENABLED=false
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Nama model bisa diganti bila penyedia mengganti/menghapus model:
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-flash-lite-latest
# MISTRAL_MODEL=mistral-small-latest
# CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
