# Salin ke .env lalu ganti nilainya. Jangan commit .env.

HTTP_PORT=8080

POSTGRES_USER=kms
POSTGRES_PASSWORD=ganti-dengan-sandi-database
POSTGRES_DB=kms

# Minimal 32 karakter. Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ganti-dengan-string-acak-minimal-32-karakter

# Sesi berakhir setelah tidak aktif selama N menit.
ACCESS_TOKEN_MINUTES=30
# true bila diakses lewat HTTPS.
COOKIE_SECURE=false

# Admin awal, dibuat sekali saat container backend start jika belum ada.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ganti-dengan-sandi-admin
SEED_ADMIN_NAME=Administrator

# --- Pipeline data (SCRUM-36 / SCRUM-38) ---
# Model embedding. Mengganti model berarti semua dokumen harus di-index ulang:
#   docker compose exec backend python -m app.ingest.requeue --all
# Model keluarga "e5" otomatis memakai awalan "passage: " / "query: ".
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_BATCH_SIZE=32
CHROMA_COLLECTION=kms_chunks
WORKER_POLL_SECONDS=5
